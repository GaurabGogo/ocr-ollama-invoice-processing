# Secrets & local env (keep `.env.example` tracked)
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/

# App data (SQLite + uploads)
data/

# Bytecode / packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.so

# Lint / test / type caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Coverage
.coverage
coverage.xml
htmlcov/

# Logs & temp
*.log
*.tmp

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
*.swp
*.swo

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (no leading / — applies in all subfolders)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
# build/ already listed above with bytecode/packaging

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

